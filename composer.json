{
  "name": "deyvo/core",
  "description": "Core package for Deyvo Laravel applications",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "illuminate/http": "^12.0",
    "illuminate/routing": "^12.0",
    "illuminate/session": "^12.0",
    "illuminate/support": "^12.0",
    "illuminate/view": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Deyvo\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Deyvo\\Core\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^10.11"
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Deyvo\\Core\\Providers\\CoreServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
