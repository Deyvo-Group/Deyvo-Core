{
  "name": "@deyvo/core",
  "private": true,
  "type": "module",
  "scripts": {
    "build:editor": "esbuild resources/js/codemirror-html-source.js --bundle --format=esm --target=es2022 --minify --legal-comments=none --outfile=resources/js/vendor/codemirror-html.js",
    "dev": "npm run build:editor && vite",
    "build": "npm run build:editor && vite build",
    "release:version": "node scripts/next-release-version.mjs"
  },
  "devDependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tailwindcss/vite": "^4.0.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0"
  }
}
